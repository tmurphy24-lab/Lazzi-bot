# Job bot environment variables.
# Copy this file to .env in the project root and fill in real values.
# .env is gitignored and is never committed. Alternatively set these as
# user-level environment variables with setx (they survive reboots).

# LinkedIn login for auto-apply (required for scheduled headless runs)
LINKEDIN_USERNAME=username@example.com
LINKEDIN_PASSWORD=example_password

# Headless scheduled runs (no visible Chrome window)
JOB_BOT_HEADLESS=True

# AI document generation (optional; leave disabled to apply with your stored resume)
JOB_BOT_USE_AI=False
JOB_BOT_AI_PROVIDER=openai
JOB_BOT_LLM_MODEL=gpt-4o-mini
JOB_BOT_LLM_API_KEY=not-needed
JOB_BOT_LLM_API_URL=https://api.openai.com/v1/
